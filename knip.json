{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/shell/main.js",
    "src/shell/registry.js",
    "src/units/*/manifest.js",
    "src/record/worker.js",
    "src/units/*/content/**/*.js",
    "src/units/*/core/typeset.logic.js",
    "src/units/go/core/own-worker.dom.js",
    "src/sw.js",
    "scripts/**/*.mjs",
    "tests/*.test.mjs",
    "src/**/*.test.js",
    "e2e/*.spec.mjs"
  ],
  "project": ["src/**/*.js", "scripts/**/*.mjs", "tests/**/*.mjs", "e2e/**/*.mjs"],
  "ignoreBinaries": ["tail", "g\\+\\+", "gdb", "nix-shell"]
}
